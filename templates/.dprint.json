{
  "lineWidth": 100,
  "indentWidth": 2,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "maintain"
  },
  "shfmt": {
    "useTabs": false,
    "switchCaseIndent": true
  },
  "includes": [
    "**/*.{json,md,sh,toml,yaml,yml}"
  ],
  "excludes": [
    "**/*.docc/**/*.md",
    "**/Artifacts/**",
    "**/ThirdParty/**",
    "**/vendor/**",
    "**/node_modules/**",
    "**/target/**",
    "**/.build/**",
    "**/.native-build/**",
    "**/bin/**",
    "**/obj/**",
    "**/build/**",
    "**/DerivedData/**",
    "**/CHANGELOG*",
    "**/HISTORY*"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "https://plugins.dprint.dev/markdown-0.28.2.wasm@77d0095123be1df7c802ef1b8875433c757f79238c26a58d1c49b8cafca44e2c",
    "https://plugins.dprint.dev/toml-0.9.0.wasm@776e088ed4255a51a80e3640e5fd20b15661147e86df3e99611aaa37e9c59852",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    "https://plugins.dprint.dev/shfmt-0.2.0.wasm@79fa31eacc1ee2735a054bfb3b4e4de2898c95f05ea3549f46b3b3063689b509"
  ]
}
